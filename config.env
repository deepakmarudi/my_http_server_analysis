# Experiment defaults. Override by exporting variables before running scripts.

SERVER_DIR="../server"
SERVER_IMAGE="epoll-perf-analytics-server"
SERVER_CONTAINER_NAME="epoll-perf-server"
SERVER_PORT="8080"
HOST_PORT="8080"
SERVER_ROOT="/app/public"
SERVER_WORKERS="4"

TARGET_PATH="/"
WORKLOAD_NAME="default-index"

# The runner defaults to a smoke experiment. Use `./loadtest/run_experiments.sh full`
# after smoke output parses successfully.
SMOKE_RATE="10"
SMOKE_DURATION_SECONDS="5"

RATES="50 100 200 400 800"
REPEATS="3"
FULL_DURATION_SECONDS="30"

WRK2_BIN="./loadtest/wrk2/wrk"
WRK_THREADS="2"
WRK_CONNECTIONS="50"
RESOURCE_SAMPLE_INTERVAL_SECONDS="1"

